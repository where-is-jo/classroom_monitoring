# recorder worker 환경변수의 기준 목록이다. 이 파일만 커밋한다.
# 이 파일을 .env.local로 복사해 값을 채운다. 실제 값이 담긴 파일은 커밋하지 않는다.
#
# 실행 전에 실제 OS 환경변수 APP_ENV를 export해야 어느 파일을 읽을지 정해진다
# (export APP_ENV=local 처럼). 없으면 .env.local을 읽는다.
#
# **이 워커는 아직 어느 스택에도 배포하지 않는다** — 영상 저장 정책이 합의되지 않았다
# (결정 0009). 그래서 컨테이너용 .docker/env/recorder.*.env도 두지 않았다.
#
# 여기 없는 값(세그먼트 길이·보존 기간 등)은 config/settings.yml에 있다.

# 실행 환경: local | dev | prod
APP_ENV=local

# 녹화할 영상 소스 목록. stream worker와 같은 형식·같은 변수를 쓴다.
# `<카메라 식별자>=<RTSP URL>`을 쉼표로 구분한다.
# 자격 증명이 포함된 URL을 쓰는 경우 이 값 전체가 비밀값이다.
# 예: camera-01=rtsp://localhost:8554/camera
STREAM_SOURCES=

# --- 객체 저장소 ---
# local | minio
# local은 MinIO 없이 적재 경로를 확인하기 위한 개발용이며 운영 보관 수단이 아니다.
# APP_ENV=prod에서는 local을 쓸 수 없다.
OBJECT_STORAGE_BACKEND=local

# --- MinIO 접속 (OBJECT_STORAGE_BACKEND=minio일 때 필수) ---
# 주소는 스킴 없이 host:port로 넣는다 (예: localhost:9000)
OBJECT_STORAGE_ENDPOINT=

# 비밀값. 어떤 형태로도 저장소에 두지 않는다.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
