# recorder worker 환경변수. 이 파일을 .env로 복사해 값을 채운다.
# 실제 값이 담긴 .env는 커밋하지 않는다.

# 실행 환경: local | dev | prod
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 녹화할 영상 소스 목록. stream worker와 같은 형식·같은 변수를 쓴다.
# `<카메라 식별자>=<RTSP URL>`을 쉼표로 구분한다.
# 자격 증명이 포함된 URL을 쓰는 경우 이 값 전체가 비밀값이다.
# 예: camera-01=rtsp://localhost:8554/camera
STREAM_SOURCES=

# --- 세그먼트 녹화 ---
# 영상 파일 하나의 길이(초). 짧으면 객체 수가 늘고, 길면 유실 시 잃는 분량이 커진다.
RECORDING_SEGMENT_SECONDS=600

# 세그먼트를 임시로 떨구는 경로. 비워두면 recorder/data/segments를 쓴다.
# 적재에 성공하면 지운다.
RECORDING_SEGMENT_DIR=

# 마지막 세그먼트가 이 시간 동안 변하지 않으면 FFmpeg이 죽은 것으로 보고 적재한다.
# RECORDING_SEGMENT_SECONDS보다 커야 한다. 작으면 쓰는 중인 파일을 올리게 된다.
RECORDING_STALE_AFTER_SECONDS=900.0

# 적재를 시도하는 주기(초)
RECORDING_UPLOAD_INTERVAL_SECONDS=30.0

# --- 보존 기간 ---
# 이 값은 아직 팀이 합의한 값이 아니다(결정 0004). 합의되면 이 주석과 함께 갱신한다.
# 영상에는 사무실 구성원의 얼굴이 담긴다.
RECORDING_RETENTION_DAYS=30

# 보존 기간이 지난 객체를 찾아 지우는 주기(초)
RECORDING_RETENTION_INTERVAL_SECONDS=3600.0

# --- 객체 저장소 ---
# local | minio
# local은 MinIO 없이 적재 경로를 확인하기 위한 개발용이며 운영 보관 수단이 아니다.
# APP_ENV=prod에서는 local을 쓸 수 없다.
OBJECT_STORAGE_BACKEND=local

# 영상 버킷 이름
OBJECT_STORAGE_BUCKET=office-recordings

# local backend가 객체를 두는 경로. 비워두면 recorder/data/objects를 쓴다.
OBJECT_STORAGE_LOCAL_DIR=

# --- MinIO 접속 (OBJECT_STORAGE_BACKEND=minio일 때 필수) ---
# 주소는 스킴 없이 host:port로 넣는다 (예: localhost:9000)
OBJECT_STORAGE_ENDPOINT=

# 비밀값. 어떤 형태로도 저장소에 두지 않는다.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# TLS 사용 여부. 로컬 MinIO는 보통 false다.
OBJECT_STORAGE_SECURE=true
