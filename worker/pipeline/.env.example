# stream + inference 조립 실행 환경변수의 기준 목록이다. 이 파일만 커밋한다.
# 실제 값이 담긴 파일은 커밋하지 않는다.
#
# 조립 실행(`python -m pipeline.main`)은 워커별 파일이 아니라 이것 하나만 읽는다.
# 같은 변수가 여러 파일에 흩어져 어느 값이 적용됐는지 모르게 되는 것을 막는다.
# 워커를 따로 실행할 때는 각 워커의 .env.local을 쓴다.
#
# 실행 방식에 따라 값을 채우는 파일이 다르다. 변수 이름의 기준은 양쪽 모두 이 파일이다.
#   소스에서 직접 실행 → 이 파일을 worker/pipeline/.env.local로 복사한다.
#                        실제 OS 환경변수 APP_ENV가 .env.{APP_ENV}를 고른다(없으면 local).
#   컨테이너로 실행     → .docker/env/worker.<환경>.env에 채운다.
#                        서버에는 이 소스 디렉터리가 없기 때문이다(결정 0017).
#
# 재시도 횟수·샘플링 주기·프레임 버퍼 크기 등 일반 설정·판정 기준값은 여기 없다.
# 조립 실행이든 단독 실행이든 항상 같은 값이라 stream/inference/pipeline 각자의
# config/settings.yml을 그대로 읽는다.

# --- 실행 환경 ---
# local | dev | prod
APP_ENV=local

# --- 영상 수신 (stream) ---
# `<카메라 식별자>=<RTSP URL>`을 쉼표로 구분한다.
# 자격 증명이 포함된 URL을 쓰는 경우 이 값 전체가 비밀값이다.
# 예: camera-01=rtsp://localhost:8554/camera
STREAM_SOURCES=

# --- USB 카메라를 직접 RTSP로 송출할 때만 ---
RTSP_PUBLISH_DEVICE_NAME=
RTSP_PUBLISH_TARGET_URL=

# --- 추론 (inference) ---
# 가중치 파일 경로. 저장소에 커밋하지 않는다.
MODEL_PATH=yolo11m.pt

# cpu | cuda. local은 보통 cpu, GPU 서버(dev)는 cuda다.
INFERENCE_DEVICE=cpu

# 모델이 내놓는 클래스 중 무엇을 탐지로 볼지. JSON `{"클래스 번호": "이름"}`이다.
# **모델을 바꾸면 함께 바꾼다.** 번호는 모델마다 다르다 — COCO 범용 모델은
# person이 0, cell phone이 67이지만 사람만 학습한 전용 모델은 클래스가 0 하나뿐이다.
# 비워 두면 {0: person, 67: cell phone}을 쓴다.
INFERENCE_TARGET_CLASS_IDS={"0": "person", "67": "cell phone"}

# --- 객체 저장소 (SNAPSHOT_ENABLED=true일 때만 필요, config/settings.yml에서 켠다) ---
# local | minio
OBJECT_STORAGE_BACKEND=local

# minio backend에서만 필요하다. 접속 정보는 비밀값이다.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# TLS 사용 여부. MinIO가 같은 compose network 안이면 false, 서버 밖으로 나가면 true다.
# 환경마다 달라지므로 여기 둔다. 버킷 이름·타임아웃은 config/settings.yml에 있다.
OBJECT_STORAGE_SECURE=true

# --- 탐지 결과 전송 (fastapi) ---
# 탐지 결과를 보낼 FastAPI 주소. 웹앱이 다른 주소로 뜨면 이 값을 바꾼다.
# 환경마다 다른 주소이므로 여기 둔다.
FASTAPI_URL=http://127.0.0.1:8001

# 얼굴 식별 내부 서비스. 비우면 얼굴 식별을 호출하지 않고 사람 탐지만 전송한다.
# compose dev에서는 같은 network의 http://deeplearning:8100 을 쓴다.
FACE_IDENTITY_URL=
# 쉼표로 구분한 입구 카메라 ID. 좌석 판정 CCTV에는 얼굴 인식을 적용하지 않는다.
FACE_IDENTITY_CAMERA_IDS=

# --- 사람 ByteTrack / 입구 → CCTV 신원 인계 ---
# 비우면 STREAM_SOURCES의 모든 카메라 사람 탐지에 ByteTrack을 붙인다.
PERSON_TRACKING_CAMERA_IDS=

# 배치별 camera_id와 CCTV의 문 영역(정규화 x1,y1,x2,y2). 후보 학생이나 문 영역의
# 신규 track이 둘 이상이면 인계하지 않는다. 실제 CCTV 화면에서 문 영역을 측정한 뒤
# 한 줄 JSON으로 넣는다.
# 예: [{"entry_camera_id":"entry-camera","classroom_camera_id":"classroom-cctv","classroom_entry_zone":[0.0,0.0,0.25,1.0]}]
IDENTITY_HANDOVER_ROUTES=
