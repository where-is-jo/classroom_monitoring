# stream + inference 조립 실행 환경변수. 이 파일을 .env로 복사해 값을 채운다.
# 실제 값이 담긴 .env는 커밋하지 않는다.
#
# 조립 실행(`python -m pipeline.main`)은 워커별 .env가 아니라 이 파일만 읽는다.
# 같은 변수가 여러 파일에 흩어져 어느 값이 적용됐는지 모르게 되는 것을 막는다.
# 워커를 따로 실행할 때는 각 워커의 .env를 쓴다.

# --- 실행 환경 ---
# local | dev | prod
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- 영상 수신 (stream) ---
# `<카메라 식별자>=<RTSP URL>`을 쉼표로 구분한다.
# 자격 증명이 포함된 URL을 쓰는 경우 이 값 전체가 비밀값이다.
# 예: camera-01=rtsp://localhost:8554/camera
STREAM_SOURCES=

STREAM_RECONNECT_MAX_RETRY=10
STREAM_RECONNECT_DELAY_SECONDS=1.0
STREAM_STARTUP_WAIT_SECONDS=3.0
STREAM_READ_FAILURE_TOLERANCE=30

# 몇 프레임마다 한 장을 추론 대상으로 고를지. 20 FPS에서 20이면 약 1초에 한 장이다.
FRAME_SAMPLE_INTERVAL_FRAMES=20

# --- USB 카메라를 직접 RTSP로 송출할 때만 ---
RTSP_PUBLISH_ENABLED=false
# dshow(Windows) | v4l2(Linux) | avfoundation(macOS)
RTSP_PUBLISH_INPUT_FORMAT=dshow
RTSP_PUBLISH_DEVICE_NAME=
RTSP_PUBLISH_TARGET_URL=
RTSP_PUBLISH_FRAMERATE=20

# --- 로컬 저장 (개발용) ---
# 영상 저장 범위와 보존 기간이 합의되지 않아 기본값은 false다.
# APP_ENV=prod에서는 활성화할 수 없다.
RECORDING_ENABLED=false
RECORDING_OUTPUT_DIR=
RECORDING_FPS=20
RECORDING_SEGMENT_SECONDS=3600
FRAME_CAPTURE_ENABLED=false
FRAME_CAPTURE_OUTPUT_DIR=

# --- 추론 (inference) ---
# 가중치 파일 경로. 저장소에 커밋하지 않는다.
MODEL_PATH=yolov8n.pt

# cpu | cuda
INFERENCE_DEVICE=cpu

# 탐지 신뢰도 임계값
INFERENCE_CONFIDENCE_THRESHOLD=0.25

# --- 탐지 스냅샷 (결정 0011) ---
# 영상 원본은 저장하지 않는다. 탐지 개수가 직전 적재와 달라질 때만 정지 이미지를 남긴다.
# 저장은 명시적으로 켠다.
SNAPSHOT_ENABLED=false

# 720p. 긴 변이 이 값을 넘을 때만 줄이고 확대하지 않는다.
SNAPSHOT_MAX_LONG_SIDE_PX=1280
SNAPSHOT_JPEG_QUALITY=80

# 카메라당 최소 적재 간격(초). 탐지가 경계에서 떨릴 때 적재가 폭주하는 것을 막는다.
# 용량 계산이 이 값에 기대고 있으므로 함부로 낮추지 않는다.
SNAPSHOT_MIN_INTERVAL_SECONDS=60

# --- 객체 저장소 (SNAPSHOT_ENABLED=true일 때만 필요) ---
# local은 MinIO 없이 적재 경로를 확인하기 위한 개발용이다. APP_ENV=prod에서는 쓸 수 없다.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=classroom-snapshots
# 비우면 inference/data/snapshots를 쓴다.
OBJECT_STORAGE_LOCAL_DIR=

# minio backend에서만 필요하다. 접속 정보는 비밀값이다.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SECURE=true
# 적재는 추론 소비자 스레드를 막는다. 저장소가 죽었을 때 오래 붙잡지 않도록 짧게 끊는다.
OBJECT_STORAGE_TIMEOUT_SECONDS=5

# --- 프레임 버퍼 (조립) ---
# 버퍼에 담아둘 최대 프레임 수. 실시간이라 최신 한 장이면 충분하다.
# 키울수록 오래된 프레임을 들고 있게 되어 지연이 커진다.
FRAME_BUFFER_MAXSIZE=1

# 버퍼가 비어 있을 때 소비자가 종료 신호를 확인하는 주기(초)
INFERENCE_POLL_TIMEOUT_SECONDS=0.5

# 연속으로 이만큼 추론에 실패하면 파이프라인을 멈춘다
INFERENCE_MAX_CONSECUTIVE_FAILURES=5
