# stream worker 환경변수. 이 파일을 .env로 복사해 값을 채운다.
# 실제 값이 담긴 .env는 커밋하지 않는다.

# 실행 환경: local | dev | prod
APP_ENV=local

# 연결할 영상 소스 목록. `<카메라 식별자>=<RTSP URL>`을 쉼표로 구분한다.
# 카메라 식별자는 소문자·숫자·하이픈만 쓴다. 로그와 저장 경로의 키가 된다.
# 자격 증명이 포함된 URL을 쓰는 경우 이 값 전체가 비밀값이다.
# 예: camera-01=rtsp://localhost:8554/camera
# 예: camera-01=rtsp://host:8554/camera1,camera-02=rtsp://host:8554/camera2
STREAM_SOURCES=

# 재연결 최대 시도 횟수
STREAM_RECONNECT_MAX_RETRY=10

# 재연결 시도 사이의 대기 시간(초)
STREAM_RECONNECT_DELAY_SECONDS=1.0

# RTSP 송출을 시작한 뒤 경로가 생기기를 기다리는 시간(초)
STREAM_STARTUP_WAIT_SECONDS=3.0

# 연속으로 이만큼 프레임을 읽지 못하면 끊긴 것으로 보고 재연결한다
STREAM_READ_FAILURE_TOLERANCE=30

# 몇 프레임마다 한 장을 샘플링할지. 20 FPS에서 20이면 약 1초에 한 장이다
FRAME_SAMPLE_INTERVAL_FRAMES=20

# 로그 수준: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- USB 카메라를 직접 RTSP로 송출할 때만 사용 ---
# Jetson이나 CCTV가 직접 RTSP를 내보내면 false로 둔다.
RTSP_PUBLISH_ENABLED=false

# FFmpeg 입력 형식: dshow(Windows) | v4l2(Linux) | avfoundation(macOS)
RTSP_PUBLISH_INPUT_FORMAT=dshow

# 카메라 장치 이름. dshow는 장치 이름, v4l2는 장치 경로(예: /dev/video0)를 넣는다.
RTSP_PUBLISH_DEVICE_NAME=

# 송출 대상 RTSP URL (예: rtsp://localhost:8554/camera)
RTSP_PUBLISH_TARGET_URL=

# 송출 프레임률
RTSP_PUBLISH_FRAMERATE=20

# --- 로컬 저장 (개발용) ---
# 영상 저장 범위와 보존 기간이 합의되지 않아 기본값은 false다.
# APP_ENV=prod에서는 활성화할 수 없다.
RECORDING_ENABLED=false

# 원본 영상 저장 경로. 비워두면 stream/data/video를 쓴다.
RECORDING_OUTPUT_DIR=

# 저장 영상의 FPS
RECORDING_FPS=20

# 영상 파일 하나의 길이(초). 3600이면 1시간마다 새 파일로 나눈다
RECORDING_SEGMENT_SECONDS=3600

# 학습용 프레임 이미지 저장 여부. APP_ENV=prod에서는 활성화할 수 없다.
FRAME_CAPTURE_ENABLED=false

# 프레임 이미지 저장 경로. 비워두면 stream/data/frames를 쓴다.
FRAME_CAPTURE_OUTPUT_DIR=
