# inference worker 환경변수. 이 파일을 .env로 복사해 값을 채운다.
# 실제 값이 담긴 .env는 커밋하지 않는다.
#
# stream과 함께 조립 실행할 때는 이 파일이 아니라 pipeline/.env를 쓴다.

# 모델 가중치 경로. 가중치 파일은 저장소에 커밋하지 않는다.
# 파일이 없으면 ultralytics가 이름을 보고 내려받는다.
MODEL_PATH=yolov8n.pt

# 실행 장치: cpu | cuda
INFERENCE_DEVICE=cpu

# 탐지 신뢰도 임계값. 이 값 미만은 결과에서 제외한다.
INFERENCE_CONFIDENCE_THRESHOLD=0.25
