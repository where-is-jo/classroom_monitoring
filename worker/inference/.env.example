# inference worker를 단독 실행할 때의 환경변수 기준 목록이다. 이 파일만 커밋한다.
# 이 파일을 .env.local로 복사해 값을 채운다. 실제 값이 담긴 파일은 커밋하지 않는다.
#
# 실행 전에 실제 OS 환경변수 APP_ENV를 export해야 어느 파일을 읽을지 정해진다
# (export APP_ENV=local 처럼). 없으면 .env.local을 읽는다.
#
# stream과 함께 조립 실행할 때는 이 파일이 아니라 pipeline/.env.{APP_ENV}를 쓴다.
# 컨테이너용 값은 .docker/env/worker.<환경>.env에 있다(결정 0017).
# 여기 없는 값(신뢰도 임계값·스냅샷 크기 등)은 config/settings.yml에 있다.

# 모델 가중치 경로. 가중치 파일은 저장소에 커밋하지 않는다.
# 파일이 없으면 ultralytics가 이름을 보고 내려받는다.
MODEL_PATH=yolo11m.pt

# 가중치 SHA-256, 클래스와 필수 전처리 여부를 묶은 JSON 계약.
# dev/prod에서는 필수이며, 가중치와 해시가 다르거나 필수 전처리를 worker가 지원하지
# 않으면 모델을 로딩하기 전에 기동을 거부한다.
MODEL_CONTRACT_PATH=

# 실행 장치: cpu | cuda. local은 보통 cpu, GPU 서버(dev)는 cuda다.
INFERENCE_DEVICE=cpu

# 모델이 내놓는 클래스 중 무엇을 탐지로 볼지. JSON `{"클래스 번호": "이름"}`이다.
# **모델을 바꾸면 함께 바꾼다.** 번호는 모델마다 다르다 — COCO 범용 모델은
# person이 0, cell phone이 67이지만 사람만 학습한 전용 모델은 클래스가 0 하나뿐이다.
# 비워 두면 {0: person, 67: cell phone}을 쓴다.
INFERENCE_TARGET_CLASS_IDS={"0": "person", "67": "cell phone"}

# --- 객체 저장소 (SNAPSHOT_ENABLED=true일 때만 필요) ---
# local | minio. local은 MinIO 없이 적재 경로를 확인하기 위한 개발용이다.
# APP_ENV=prod에서는 쓸 수 없다.
OBJECT_STORAGE_BACKEND=local

# minio backend에서만 필요하다. 접속 정보는 비밀값이다.
# 주소는 스킴 없이 host:port로 넣는다 (예: localhost:9000)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# TLS 사용 여부. MinIO가 같은 compose network 안이면 false, 서버 밖으로 나가면 true다.
# 환경마다 달라지므로 여기 둔다. 버킷 이름·타임아웃은 config/settings.yml에 있다.
OBJECT_STORAGE_SECURE=true
