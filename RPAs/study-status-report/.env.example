SCHEDULE_FILE_PATH=individual_tasks/시간표.md
FASTAPI_BASE_URL=http://localhost:8000
CLASSROOM_ID=classroom-a
CLASSROOM_NAME=A강의실
REPORT_OUTPUT_DIR=RPAs/study-status-report/reports

# Required for .xlsx file upload. Incoming webhooks can send messages, not files.
# 실제 값은 워크스페이스가 바뀔 때마다 달라지므로 여기 채우지 않는다 — README의
# "Slack 채널 URL에서 채널 ID 읽는 법"을 참고해 각자 .env에 넣는다.
SLACK_CHANNEL_ID=

# Store real values in n8n credentials, environment variables, or a secret manager.
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# 워크플로 on/off 스크립트(scripts/toggle_workflow.py)가 쓴다.
# API 키는 n8n 편집기 > Settings > n8n API 에서 발급한다. 비밀값이다.
N8N_BASE_URL=
N8N_API_KEY=
