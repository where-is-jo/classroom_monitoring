            "axisLabel": "초당 프레임"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "탐지 신뢰도 중앙값 (클래스별)",
      "description": "**모델 품질이 조용히 나빠지는 것을 잡는 자리다.** 지연과 처리량은 시스템이 도는지만 알려주고 모델이 맞는 답을 내는지는 알려주지 않는다. 정답 라벨이 없는 운영 환경에서는 촬영 환경이 바뀌면(카메라 각도, 조명, 렌즈 가림) 탐지가 끊기기 전에 이 값이 먼저 내려간다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (class_name, le) (rate(classroom_monitoring_detection_confidence_bucket[$__rate_interval])))",
          "legendFormat": "{{class_name}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": ""
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
