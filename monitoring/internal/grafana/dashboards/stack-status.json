{
  "uid": "classroom-monitoring-stack",
  "title": "스택 상태 — 로그와 스크랩",
  "description": "dev(공용 GPU 서버) 스택이 실제로 살아 있는지 확인하는 대시보드. Alloy가 수집한 컨테이너 로그와 Prometheus의 up만 쓴다. 서비스가 제 일을 하고 있는지는 '애플리케이션 지표' 대시보드가 본다.",
  "tags": ["classroom-monitoring", "infra"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "컨테이너",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "container",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{stack=~\"classroom-monitoring-dev.*\"}",
          "type": 1
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prometheus 스크랩 타겟",
      "description": "Prometheus가 스크랩하는 타겟의 up 값. prometheus·fastapi·deeplearning·inference-worker 네 job이 대상이다. dev에서 fastapi는 개인 PC에 있어 노트북이 꺼져 있으면 up=0이 되는데, 이는 장애가 아닐 수 있다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "instant": true,
          "range": false,
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "로그를 보낸 컨테이너 수",
      "description": "선택한 시간 범위 안에 로그가 한 줄이라도 들어온 컨테이너 수. minio·caddy처럼 기동 후 조용한 컨테이너는 짧은 범위에서 빠질 수 있으므로 스택 컨테이너 수와 항상 같지는 않다. 0이면 Alloy 수집이 끊긴 것이다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(count by (container) (count_over_time({stack=~\"classroom-monitoring-dev.*\"}[$__range])))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "최근 5분 오류 로그",
      "description": "error / exception / traceback / panic / fatal 이 포함된 로그 줄 수. 단순 문자열 매칭이라 오탐이 있을 수 있다 — 숫자보다 추세를 본다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({stack=~\"classroom-monitoring-dev.*\"} |~ `(?i)(error|exception|traceback|panic|fatal)` [5m]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "컨테이너별 로그 발생량",
      "description": "초당 로그 줄 수. 갑자기 0이 되면 컨테이너가 죽었거나 Alloy 수집이 끊긴 것이다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (rate({stack=~\"classroom-monitoring-dev.*\", container=~\"$container\"}[$__rate_interval]))",
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "컨테이너별 오류 로그 발생량",
      "description": "위와 같은 문자열 매칭 기준. 어느 컨테이너가 오류를 내는지 구분하는 용도다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (rate({stack=~\"classroom-monitoring-dev.*\", container=~\"$container\"} |~ `(?i)(error|exception|traceback|panic|fatal)` [$__rate_interval]))",
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "로그 원문",
      "description": "위 컨테이너 변수로 대상을 좁힐 수 있다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{stack=~\"classroom-monitoring-dev.*\", container=~\"$container\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
