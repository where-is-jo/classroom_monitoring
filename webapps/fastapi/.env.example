# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 규칙: docs/conventions/environment-convention.md
#
# 실행 환경: local | dev | prod
APP_ENV=local

# 메타데이터 저장소: memory | mongodb (memory는 local에서만 허용)
DATABASE_MODE=memory

# MongoDB mode의 접속 정보와 database 이름 (접속 정보는 비밀값)
DATABASE_URL=
DATABASE_NAME=

# MongoDB 연결 제한 시간(초)
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# 개발용 mock 입력 허용 여부 (prod에서는 true 금지)
# true이면 mock 직원·좌석 관측 API와 /admin/dev-tools 화면을 등록한다.
MOCK_INPUTS_ENABLED=false

# 합성 모니터링·영상 검색 목업 노출 여부 (local/dev 전용, prod에서는 true 금지)
DEMO_MODE_ENABLED=false

# mock 입력 허용 환경의 인앱 알림 delivery 기록 모드와 최대 명시적 시도 횟수
# success | fail_once | always_fail (외부 네트워크나 SDK를 사용하지 않음)
NOTIFICATION_MOCK_DELIVERY_MODE=success
NOTIFICATION_MOCK_DELIVERY_MAX_ATTEMPTS=3

# 면담 대기 기본 만료 시간(시간)
INTERVIEW_WAIT_EXPIRES_AFTER_HOURS=24

# mock 좌석 점유를 UNKNOWN과 OCCUPIED/VACANT로 나누는 confidence 기준
SEAT_OCCUPANCY_CONFIDENCE_THRESHOLD=0.6

# 직원 상태 시간 정책(초). away 기준은 offsite 기준보다 작아야 한다.
EMPLOYEE_AWAY_AFTER_SECONDS=180
EMPLOYEE_OFFSITE_AFTER_SECONDS=3600

# 인증 필수 비밀값. 각각 32자 이상의 서로 다른 무작위 값을 주입한다.
# 예시 파일에 실제 운영 값을 기록하거나 커밋하지 않는다.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
AUDIT_IP_HASH_SECRET=

# 브라우저 쓰기 요청의 허용 origin. 끝의 /는 생략한다.
WEB_ORIGIN=http://127.0.0.1:8000

# 인증 정책(초/횟수)
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCKOUT_SECONDS=900
AUTH_IP_MAX_FAILURES=20
AUTH_IP_WINDOW_SECONDS=300
AUTH_PASSWORD_MIN_LENGTH=12

# 네 역할의 가상 사용자 seed. opt-in이며 비밀번호는 환경에서만 주입한다.
AUTH_SEED_ENABLED=false
AUTH_SEED_STUDENT_PASSWORD=
AUTH_SEED_STAFF_PASSWORD=
AUTH_SEED_ADMIN_PASSWORD=
AUTH_SEED_SYSTEM_OPERATOR_PASSWORD=

# 신뢰도 등급 판정 임계값 (0.0 ~ 1.0)
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.50

# 페이지네이션
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200

# 선택적 MongoDB 통합 테스트 전용 URL. URL 경로의 database 이름은 test_로 시작해야 한다.
TEST_DATABASE_URL=
