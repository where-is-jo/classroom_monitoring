# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 규칙: docs/conventions/environment-convention.md
#
# 현재는 인메모리 어댑터만 쓰므로 필수값이 없다. 아래는 모두 선택 항목이며
# 비워두면 코드의 기본값이 적용된다.

# 실행 환경: local | dev | prod
APP_ENV=local

# 신뢰도 등급 판정 임계값 (0.0 ~ 1.0)
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.50

# 페이지네이션
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200

# --- 아래는 어댑터 추가 시 필요해진다. 지금은 사용하지 않는다 ---
# MongoDB 접속 정보 — 비밀값. 기본값 없이 주입한다.
# DATABASE_URL=
# MinIO 접속 정보 — 비밀값.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
