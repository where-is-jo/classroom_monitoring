# fastapi 환경변수의 기준 목록이다. 이 파일만 커밋한다 — 실제 값이 담긴 파일은 커밋하지 않는다.
# 규칙: docs/conventions/environment-convention.md
#
# 실행 방식에 따라 값을 채우는 파일이 다르다. 변수 이름의 기준은 양쪽 모두 이 파일이다.
#   소스에서 직접 실행 → 이 파일을 webapps/fastapi/.env.local로 복사한다.
#                        실제 OS 환경변수 APP_ENV가 .env.{APP_ENV}를 고른다(없으면 local).
#   컨테이너로 실행     → .docker/env/fastapi.<환경>.env에 채운다.
#                        서버에는 이 소스 디렉터리가 없기 때문이다(결정 0017).
#
# 타임아웃·페이지 크기·얼굴 품질 임계값처럼 어느 환경에서나 같은 값은 여기 없다.
# 저장소에 커밋되는 config/settings.yml이 갖는다.

# 실행 환경: local | dev | prod
APP_ENV=local

# 메타데이터 저장소: memory | mongodb (memory는 local에서만 허용된다)
# local은 memory, dev/prod는 mongodb를 쓴다.
DATABASE_MODE=memory

# MongoDB 접속 정보와 database 이름. 접속 정보는 비밀값이다.
DATABASE_URL=
DATABASE_NAME=

# Synthetic monitoring demo without personal data (local/dev only)
DEMO_MODE_ENABLED=false

# Confidence threshold for treating low-confidence seat observations as UNKNOWN
SEAT_OCCUPANCY_CONFIDENCE_THRESHOLD=0.6

# 오프라인 migration cutover 게이트. 승인된 암호화 target/KMS 준비 시에만 true로
# 전환한다. false면 migration run(cutover)을 차단한다.
MIGRATION_ENCRYPTION_TARGET_APPROVED=false

# Page size
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200

# 능동형 얼굴 등록 완료 조건과 pose quota
FACE_ENROLLMENT_REQUIRED_SAMPLES=120
FACE_ENROLLMENT_AUGMENTED_SAMPLES=180
FACE_POSE_FRONT_QUOTA=32
FACE_POSE_LEFT_QUOTA=24
FACE_POSE_RIGHT_QUOTA=24
FACE_POSE_UP_QUOTA=20
FACE_POSE_DOWN_QUOTA=20

# 얼굴 분석 임계값. 실제 등록 장비 벤치마크 후 조정한다.
FACE_DETECTION_CONFIDENCE_MIN=0.65
FACE_SIZE_RATIO_MIN=0.08
FACE_ROLL_DEGREES_MAX=20
FACE_BLUR_SCORE_MIN=0.3
FACE_BRIGHTNESS_SCORE_MIN=0.2
FACE_LANDMARK_CONFIDENCE_MIN=0.8
FACE_OCCLUSION_SCORE_MAX=0.3
FACE_DUPLICATE_SCORE_MAX=0.99
FACE_MOTION_SPEED_DPS_MAX=220
FACE_YAW_SIDE_DEGREES=10
FACE_PITCH_SIDE_DEGREES=8
# 아래 방향은 카메라 각도상 변화량이 작아 별도 완화 기준을 사용한다.
FACE_PITCH_DOWN_DEGREES=5

# local 테스트에서만 유효 JPEG를 파일로 확인한다. 실제 얼굴이므로 기본 비활성화한다.
FACE_LOCAL_SAMPLE_STORAGE_ENABLED=false
FACE_LOCAL_SAMPLE_STORAGE_DIR=local_face_data
# 얼굴 분석 companion 프로세스. local은 synthetic(외부 의존 없음), dev/prod는 실제 서비스.
# synthetic | http
FACE_ANALYZER_MODE=synthetic
FACE_ANALYZER_URL=http://127.0.0.1:8100

# 선택적 MongoDB 통합 테스트용 URL. database 이름은 test_로 시작해야 한다.
TEST_DATABASE_URL=

# SSE settings
SSE_HEARTBEAT_INTERVAL_SECONDS=30
SSE_RECONNECTION_TIMEOUT_SECONDS=60

# Detection event settings
DETECTION_EVENT_MAX_DETECTIONS_PER_EVENT=100
DETECTION_EVENT_STALE_SECONDS=300

# WHEP 재생 proxy와 재생 세션 (결정 0014)
# proxy target은 이 base URL과 source의 camera_id로만 조립한다.
WHEP_BASE_URL=http://127.0.0.1:8889
WHEP_TIMEOUT_SECONDS=5
PLAYBACK_SESSION_TTL_SECONDS=300
# local/http 개발 환경에서는 false로 내려야 owner cookie가 전송된다.
PLAYBACK_SESSION_COOKIE_SECURE=true
PLAYBACK_SESSION_SDP_MAX_BYTES=65536

# 탐지 스냅샷 저장소 (결정 0011). 영상 원본을 저장하지 않는 대신 남기는 정지 이미지다.
# fastapi는 읽기만 한다 — 적재는 worker가, 삭제는 MinIO lifecycle이 한다.
# memory | minio (memory는 MinIO 없이 화면을 띄우기 위한 개발용이며 빈 목록을 돌려준다)
SNAPSHOT_STORAGE_BACKEND=memory

# minio backend에서만 필요하다. 접속 정보는 비밀값이다.
SNAPSHOT_STORAGE_ENDPOINT=
SNAPSHOT_STORAGE_ACCESS_KEY=
SNAPSHOT_STORAGE_SECRET_KEY=

# TLS 사용 여부. MinIO가 같은 compose network 안이면 false, 서버 밖으로 나가면 true다.
# 환경마다 달라지므로 여기 둔다. 버킷 이름·타임아웃은 config/settings.yml에 있다.
SNAPSHOT_STORAGE_SECURE=true

# 자연어 탐지 검색 (결정 0016). LLM은 질문을 검색 조건 JSON으로 바꾸는 데서 끝나고,
# 검증과 DB 조회는 fastapi가 한다.
# 타임아웃·기간 상한·스캔 상한은 어느 환경에서나 같은 값이라 여기 없다 —
# config/settings.yml이 갖는다.
#
# stub | llama (stub은 LLM 없이 계약과 화면을 확인하기 위한 대역이며 "오늘 하루"만 돌려준다)
# local은 stub, llama-server를 띄운 환경에서만 llama로 바꾼다.
LLM_SEARCH_MODE=stub
# llama-server(.docker/compose.llm.yml)가 여는 OpenAI 호환 API 주소.
# 컨테이너 안에서는 서비스 이름으로 부른다 (예: http://llama-server:8008)
LLM_SEARCH_URL=http://127.0.0.1:8008
# llama-server의 LLAMA_ARG_ALIAS와 같은 값이어야 한다. 배포마다 다를 수 있어 여기 둔다.
LLM_SEARCH_MODEL=gemma
