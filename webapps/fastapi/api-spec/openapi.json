{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Office Monitoring — API 설계 명세",
    "version": "0.1.0-draft",
    "description": "`individual_tasks/api명세서.md`(Draft v0.1)를 OpenAPI로 옮긴 **설계 초안**이다.\n\n- 이 문서의 엔드포인트는 **아직 구현되지 않았다.** 구현 전 계약 합의용이다.\n- 현재 실행 중인 애플리케이션(`/docs`, `/openapi.json`)은 화면 mockup 용도이며, 이 명세와 별개다. 경로가 겹치더라도 여기 정의를 목표 계약으로 본다.\n- 구현되지 않았으므로 이 화면에서는 요청 실행(Try it out)을 제공하지 않는다.\n- 로그인 후 역할(학생/직원/관리자)에 따라 접근 화면이 나뉜다.\n- 각 엔드포인트 설명 첫 줄의 **상태**는 원본 명세서의 범례를 그대로 옮긴 것이다. **확정**은 화면 기획 확정, 구현만 남은 상태. **신규**는 이번 기획에서 새로 추가된 기능. **대기**는 다른 작업(서버/AI 모델 등) 완료가 선행되어야 하는 상태다.\n- 인증 방식(토큰 종류, 헤더 형식), 각 상태값의 허용 목록은 **결정 필요**. 따라서 이 문서에는 `securitySchemes`를 정의하지 않았다.\n- 구현이 끝나면 자동 생성되는 OpenAPI 문서가 정본이 되고, 이 문서는 폐기한다."
  },
  "externalDocs": {
    "description": "원본 명세서 (individual_tasks/api명세서.md). individual_tasks/는 gitignore 대상이라 로컬에만 존재한다.",
    "url": "individual_tasks/api명세서.md"
  },
  "tags": [
    {
      "name": "auth",
      "description": "로그인, 비밀번호 변경"
    },
    {
      "name": "employees",
      "description": "직원 상태 조회. 학생·직원 화면 공통"
    },
    {
      "name": "seats",
      "description": "강의실 좌석 조회. 학생·직원 화면 공통"
    },
    {
      "name": "interviews",
      "description": "면담 신청·조회. 학생·직원 화면 공통"
    },
    {
      "name": "monitoring",
      "description": "직원 전용 모니터링 — 근무 상태 변경, CCTV, 영상 검색"
    },
    {
      "name": "admin",
      "description": "관리자 전용 — 대시보드, 사용자/직원/강의실 관리"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "로그인",
        "description": "**상태:** 확정",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "id": "student01", "password": "changeme" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" },
                "example": { "token": "eyJhbGciOi...", "role": "student" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/auth/password": {
      "put": {
        "tags": ["auth"],
        "summary": "비밀번호 변경",
        "description": "**상태:** 신규\n\n임시 비밀번호 최초 변경용.",
        "operationId": "changePassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordChangeRequest" },
              "example": { "currentPassword": "temp-1234", "newPassword": "new-secret-pw" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": { "success": true }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/employees": {
      "get": {
        "tags": ["employees"],
        "summary": "직원 상태 조회 (검색·필터)",
        "description": "**상태:** 확정",
        "operationId": "listEmployees",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "직원 이름 등으로 검색.",
            "schema": { "type": "string" },
            "example": "홍길동"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "부서·근무 상태 등으로 거른다. 허용값 목록은 **결정 필요**.",
            "schema": { "type": "string" },
            "example": "working"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmployeeList" },
                "example": [
                  {
                    "id": "emp-001",
                    "name": "홍길동",
                    "department": "개발팀",
                    "workStatus": "working"
                  }
                ]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/rooms/{roomId}/seats": {
      "get": {
        "tags": ["seats"],
        "summary": "좌석 조회",
        "description": "**상태:** 확정",
        "operationId": "listRoomSeats",
        "parameters": [{ "$ref": "#/components/parameters/RoomId" }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SeatList" },
                "example": [
                  { "seatId": "seat-001", "seatNumber": "A-01", "inUse": true }
                ]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/interviews": {
      "post": {
        "tags": ["interviews"],
        "summary": "면담 신청 (학생 전용)",
        "description": "**상태:** 대기 — 직원↔직원 면담 필요 여부 확인 필요",
        "operationId": "createInterview",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InterviewCreateRequest" },
              "example": { "staffId": "emp-001", "requestedTime": "2026-08-10T05:00:00Z" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "신청 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewCreateResponse" },
                "example": { "interviewId": "iv-001", "status": "requested" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/interviews/me": {
      "get": {
        "tags": ["interviews"],
        "summary": "내가 신청한 면담 조회",
        "description": "**상태:** 확정",
        "operationId": "listMyInterviews",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewMeList" },
                "example": [
                  {
                    "interviewId": "iv-001",
                    "counterpartName": "홍길동",
                    "requestedTime": "2026-08-10T05:00:00Z",
                    "status": "requested"
                  }
                ]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/interviews/received": {
      "get": {
        "tags": ["interviews"],
        "summary": "나에게 신청된 면담 목록 (직원 업무)",
        "description": "**상태:** 확정",
        "operationId": "listReceivedInterviews",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewReceivedList" },
                "example": [
                  {
                    "interviewId": "iv-001",
                    "requesterName": "김학생",
                    "requestedTime": "2026-08-10T05:00:00Z",
                    "status": "requested"
                  }
                ]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/profile/status": {
      "put": {
        "tags": ["monitoring"],
        "summary": "근무 상태 변경 (프로필 클릭)",
        "description": "**상태:** 신규",
        "operationId": "updateProfileStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileStatusUpdateRequest" },
              "example": { "status": "away" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": { "success": true }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/cctv/{roomId}/stream": {
      "get": {
        "tags": ["monitoring"],
        "summary": "CCTV 실시간 스트리밍",
        "description": "**상태:** 대기 — 시트 K열(Local DB/Docker) 서버 세팅 선행 필요",
        "operationId": "getCctvStream",
        "parameters": [{ "$ref": "#/components/parameters/RoomId" }],
        "responses": {
          "200": {
            "description": "스트림 정보 발급 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CctvStreamResponse" },
                "example": {
                  "streamUrl": "https://stream.example.com/rooms/room-001",
                  "token": "eyJhbGciOi..."
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/video/search": {
      "post": {
        "tags": ["monitoring"],
        "summary": "자연어로 영상 검색",
        "description": "**상태:** 대기 — 딥러닝/검색 모델 연동 이후 확정",
        "operationId": "searchVideo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VideoSearchRequest" },
              "example": { "query": "어제 오후에 전화 통화하는 장면" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "검색 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoSearchResultList" },
                "example": [
                  {
                    "thumbnailUrl": "https://minio.example.com/thumbnails/clip-001.jpg",
                    "timeRangeStart": "2026-08-06T05:00:00Z",
                    "timeRangeEnd": "2026-08-06T05:02:00Z"
                  }
                ]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/admin/dashboard": {
      "get": {
        "tags": ["admin"],
        "summary": "관리자 대시보드",
        "description": "**상태:** 확정",
        "operationId": "getAdminDashboard",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminDashboardResponse" },
                "example": {
                  "employeeSummary": { "total": 24, "working": 15, "away": 4, "offWork": 5 },
                  "roomSummary": { "total": 6, "inUse": 4 },
                  "alertSummary": { "total": 2, "unresolved": 1 },
                  "statusDistribution": { "working": 15, "on_call": 3, "away": 4, "off_work": 2 }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/admin/users": {
      "post": {
        "tags": ["admin"],
        "summary": "사용자 계정 생성",
        "description": "**상태:** 확정",
        "operationId": "createAdminUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminUserCreateRequest" },
              "example": { "id": "student01", "tempPassword": "temp-1234", "role": "student" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminUserCreateResponse" },
                "example": { "userId": "user-001" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/admin/staff": {
      "post": {
        "tags": ["admin"],
        "summary": "직원 프로필 생성 (계정 연동)",
        "description": "**상태:** 확정",
        "operationId": "createAdminStaff",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminStaffCreateRequest" },
              "example": {
                "userId": "user-001",
                "department": "개발팀",
                "position": "사원",
                "seat": "A-01"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminStaffCreateResponse" },
                "example": { "staffId": "emp-001" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/admin/rooms": {
      "get": {
        "tags": ["admin"],
        "summary": "강의실 정보·일정·좌석 관리",
        "description": "**상태:** 확정\n\n등록/수정은 `PUT /api/admin/rooms/{roomId}`로 분리할 예정이다. 아직 이 문서에는 없다.",
        "operationId": "listAdminRooms",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminRoomList" },
                "example": [
                  {
                    "roomId": "room-001",
                    "info": "개발팀 사무실",
                    "schedule": [
                      { "title": "주간 회의", "startTime": "2026-08-10T01:00:00Z", "endTime": "2026-08-10T02:00:00Z" }
                    ],
                    "seatLayout": [
                      { "seatId": "seat-001", "seatNumber": "A-01", "inUse": true }
                    ]
                  }
                ]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "RoomId": {
        "name": "roomId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "example": "room-001"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 요청 값",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "인증되지 않음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "권한 없음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "요청한 자원이 없음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "현재 상태와 충돌",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ValidationError": {
        "description": "요청 스키마 검증 실패",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalError": {
        "description": "서버 내부 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "내부 서비스 사용 불가",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message", "details"],
        "properties": {
          "code": {
            "type": "string",
            "description": "대문자 스네이크 표기 오류 코드.",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "description": "사용자에게 보여줄 수 있는 한국어 설명. 스택 트레이스·쿼리·내부 주소를 넣지 않는다."
          },
          "details": {
            "type": "object",
            "description": "추가 정보. 없으면 빈 객체.",
            "additionalProperties": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetail" }
        },
        "example": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "요청 값이 올바르지 않습니다.",
            "details": {}
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "사용자 역할. `student` 학생 / `staff` 직원 / `admin` 관리자.",
        "enum": ["student", "staff", "admin"]
      },
      "LoginRequest": {
        "type": "object",
        "required": ["id", "password"],
        "properties": {
          "id": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["token", "role"],
        "properties": {
          "token": { "type": "string", "description": "인증 토큰. 형식·만료 정책은 **결정 필요**." },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "PasswordChangeRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string" },
          "newPassword": { "type": "string" }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": { "type": "boolean" }
        }
      },
      "EmployeeStatusValue": {
        "type": "string",
        "description": "직원 근무 상태. 허용값 목록은 **결정 필요**.",
        "example": "working"
      },
      "EmployeeSummary": {
        "type": "object",
        "description": "직원 상태 목록 항목. `id`는 다른 API(면담 신청 등)에서 직원을 참조하기 위해 추가했다 — 명세서에는 명시되지 않았다.",
        "required": ["id", "name", "department", "workStatus"],
        "properties": {
          "id": { "type": "string", "example": "emp-001" },
          "name": { "type": "string", "example": "홍길동" },
          "department": { "type": "string", "example": "개발팀" },
          "workStatus": { "$ref": "#/components/schemas/EmployeeStatusValue" }
        }
      },
      "EmployeeList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/EmployeeSummary" }
      },
      "Seat": {
        "type": "object",
        "required": ["seatId", "seatNumber", "inUse"],
        "properties": {
          "seatId": { "type": "string", "example": "seat-001" },
          "seatNumber": { "type": "string", "example": "A-01" },
          "inUse": { "type": "boolean" }
        }
      },
      "SeatList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/Seat" }
      },
      "InterviewStatus": {
        "type": "string",
        "description": "면담 상태. 허용값 목록은 **결정 필요**.",
        "example": "requested"
      },
      "InterviewCreateRequest": {
        "type": "object",
        "required": ["staffId", "requestedTime"],
        "properties": {
          "staffId": { "type": "string", "description": "면담 대상 직원 ID.", "example": "emp-001" },
          "requestedTime": { "type": "string", "format": "date-time" }
        }
      },
      "InterviewCreateResponse": {
        "type": "object",
        "required": ["interviewId", "status"],
        "properties": {
          "interviewId": { "type": "string", "example": "iv-001" },
          "status": { "$ref": "#/components/schemas/InterviewStatus" }
        }
      },
      "InterviewMeItem": {
        "type": "object",
        "description": "학생이 신청한 면담 목록 항목. `대상`을 `counterpartName`으로 옮겼다.",
        "required": ["interviewId", "counterpartName", "requestedTime", "status"],
        "properties": {
          "interviewId": { "type": "string" },
          "counterpartName": { "type": "string", "example": "홍길동" },
          "requestedTime": { "type": "string", "format": "date-time" },
          "status": { "$ref": "#/components/schemas/InterviewStatus" }
        }
      },
      "InterviewMeList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/InterviewMeItem" }
      },
      "InterviewReceivedItem": {
        "type": "object",
        "description": "직원에게 신청된 면담 목록 항목. `신청자`를 `requesterName`으로 옮겼다.",
        "required": ["interviewId", "requesterName", "requestedTime", "status"],
        "properties": {
          "interviewId": { "type": "string" },
          "requesterName": { "type": "string", "example": "김학생" },
          "requestedTime": { "type": "string", "format": "date-time" },
          "status": { "$ref": "#/components/schemas/InterviewStatus" }
        }
      },
      "InterviewReceivedList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/InterviewReceivedItem" }
      },
      "ProfileStatusUpdateRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/EmployeeStatusValue" }
        }
      },
      "CctvStreamResponse": {
        "type": "object",
        "required": ["streamUrl", "token"],
        "properties": {
          "streamUrl": { "type": "string", "format": "uri" },
          "token": { "type": "string", "description": "스트림 접근 토큰. 만료 정책은 **결정 필요**." }
        }
      },
      "VideoSearchRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "description": "자연어 검색어.", "example": "어제 오후에 전화 통화하는 장면" }
        }
      },
      "VideoSearchResultItem": {
        "type": "object",
        "description": "명세서의 `썸네일`, `시간대`를 옮겼다. 매칭 근거(유사도 점수 등)는 검색 모델 연동 후 확정한다.",
        "required": ["thumbnailUrl", "timeRangeStart", "timeRangeEnd"],
        "properties": {
          "thumbnailUrl": { "type": "string", "format": "uri" },
          "timeRangeStart": { "type": "string", "format": "date-time" },
          "timeRangeEnd": { "type": "string", "format": "date-time" }
        }
      },
      "VideoSearchResultList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/VideoSearchResultItem" }
      },
      "AdminDashboardResponse": {
        "type": "object",
        "description": "명세서의 `직원/강의실/경고 요약, 상태 분포`를 옮겼다. 각 요약의 세부 필드는 **결정 필요** — 예시 값이다.",
        "required": ["employeeSummary", "roomSummary", "alertSummary", "statusDistribution"],
        "properties": {
          "employeeSummary": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 },
            "example": { "total": 24, "working": 15, "away": 4, "offWork": 5 }
          },
          "roomSummary": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 },
            "example": { "total": 6, "inUse": 4 }
          },
          "alertSummary": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 },
            "example": { "total": 2, "unresolved": 1 }
          },
          "statusDistribution": {
            "type": "object",
            "description": "근무 상태값별 인원 수.",
            "additionalProperties": { "type": "integer", "minimum": 0 },
            "example": { "working": 15, "on_call": 3, "away": 4, "off_work": 2 }
          }
        }
      },
      "AdminUserCreateRequest": {
        "type": "object",
        "required": ["id", "tempPassword", "role"],
        "properties": {
          "id": { "type": "string" },
          "tempPassword": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "AdminUserCreateResponse": {
        "type": "object",
        "required": ["userId"],
        "properties": {
          "userId": { "type": "string", "example": "user-001" }
        }
      },
      "AdminStaffCreateRequest": {
        "type": "object",
        "required": ["userId", "department", "position", "seat"],
        "properties": {
          "userId": { "type": "string", "description": "`POST /api/admin/users`로 만든 계정 ID." },
          "department": { "type": "string", "example": "개발팀" },
          "position": { "type": "string", "example": "사원" },
          "seat": { "type": "string", "description": "좌석 번호.", "example": "A-01" }
        }
      },
      "AdminStaffCreateResponse": {
        "type": "object",
        "required": ["staffId"],
        "properties": {
          "staffId": { "type": "string", "example": "emp-001" }
        }
      },
      "RoomScheduleItem": {
        "type": "object",
        "required": ["title", "startTime", "endTime"],
        "properties": {
          "title": { "type": "string" },
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": "string", "format": "date-time" }
        }
      },
      "AdminRoomListItem": {
        "type": "object",
        "description": "명세서의 `정보, 일정, 좌석 배치`를 옮겼다.",
        "required": ["roomId", "info", "schedule", "seatLayout"],
        "properties": {
          "roomId": { "type": "string", "example": "room-001" },
          "info": { "type": "string", "example": "개발팀 사무실" },
          "schedule": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RoomScheduleItem" }
          },
          "seatLayout": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Seat" }
          }
        }
      },
      "AdminRoomList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/AdminRoomListItem" }
      }
    }
  }
}
