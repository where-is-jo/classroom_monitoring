{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Office Monitoring — API 설계 명세",
    "version": "0.1.0-draft",
    "description": "`individual_tasks/API명세서.md`를 OpenAPI로 옮긴 **설계 초안**이다.\n\n- 이 문서의 엔드포인트는 **아직 구현되지 않았다.** 구현 전 계약 합의용이다.\n- 현재 실행 중인 애플리케이션(`/docs`, `/openapi.json`)은 화면 mockup 용도이며, 이 명세와 별개다. 경로가 겹치더라도 여기 정의를 목표 계약으로 본다.\n- 구현되지 않았으므로 이 화면에서는 요청 실행(Try it out)을 제공하지 않는다.\n- 인증·권한, 실시간 갱신 방식, 영상 보존 범위는 **결정 필요** 상태다. 따라서 이 문서에는 `securitySchemes`를 정의하지 않았다.\n- 구현이 끝나면 자동 생성되는 OpenAPI 문서가 정본이 되고, 이 문서는 폐기한다."
  },
  "externalDocs": {
    "description": "원본 명세서 (individual_tasks/API명세서.md)",
    "url": "https://github.com/ChulGeunHatJo/smart-office-monitoring/blob/main/individual_tasks/API%EB%AA%85%EC%84%B8%EC%84%9C.md"
  },
  "tags": [
    {
      "name": "dashboard",
      "description": "대시보드 요약"
    },
    {
      "name": "employee-statuses",
      "description": "직원 상태 조회와 수동 변경"
    },
    {
      "name": "employees",
      "description": "직원 정보"
    },
    {
      "name": "seats",
      "description": "좌석"
    },
    {
      "name": "cameras",
      "description": "카메라"
    },
    {
      "name": "detections",
      "description": "AI 탐지 기록"
    },
    {
      "name": "status-rules",
      "description": "상태 판정 규칙"
    },
    {
      "name": "internal",
      "description": "내부 서비스 전용 (`/internal/v1`). 브라우저에 노출하지 않는다."
    }
  ],
  "paths": {
    "/api/v1/dashboard/summary": {
      "get": {
        "tags": ["dashboard"],
        "summary": "대시보드 요약 조회",
        "description": "전체 직원 상태를 한눈에 보여주기 위한 요약 정보를 반환한다. MVP 우선순위 1번.",
        "operationId": "getDashboardSummary",
        "responses": {
          "200": {
            "description": "요약 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardSummary" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/employee-statuses": {
      "get": {
        "tags": ["employee-statuses"],
        "summary": "직원 상태 목록 조회",
        "description": "대시보드의 직원 상태 목록을 조회한다. MVP 우선순위 2번.",
        "operationId": "listEmployeeStatuses",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "직원 상태로 거른다.",
            "schema": { "$ref": "#/components/schemas/EmployeeStatusValue" }
          },
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "좌석 구역으로 거른다.",
            "schema": { "type": "string" },
            "example": "개발팀 구역"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "직원 이름으로 검색한다.",
            "schema": { "type": "string" },
            "example": "홍길동"
          },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" }
        ],
        "responses": {
          "200": {
            "description": "목록 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmployeeStatusList" },
                "example": {
                  "items": [
                    {
                      "employee_id": "emp-001",
                      "employee_name": "홍길동",
                      "seat_id": "seat-001",
                      "seat_name": "A-01",
                      "area": "개발팀 구역",
                      "status": "working",
                      "source": "ai",
                      "last_detected_at": "2026-08-06T01:20:30Z",
                      "status_changed_at": "2026-08-06T01:10:00Z",
                      "memo": "오전 외근 가능성 있음"
                    }
                  ],
                  "total": 1,
                  "limit": 50,
                  "offset": 0
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/employee-statuses/{employee_id}": {
      "get": {
        "tags": ["employee-statuses"],
        "summary": "직원 상태 상세 조회",
        "description": "특정 직원의 현재 상태와 최근 탐지 정보를 조회한다. MVP 우선순위 3번.",
        "operationId": "getEmployeeStatus",
        "parameters": [{ "$ref": "#/components/parameters/EmployeeId" }],
        "responses": {
          "200": {
            "description": "상세 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmployeeStatusDetail" },
                "example": {
                  "employee_id": "emp-001",
                  "employee_name": "홍길동",
                  "seat_id": "seat-001",
                  "seat_name": "A-01",
                  "area": "개발팀 구역",
                  "status": "working",
                  "source": "ai",
                  "last_detected_at": "2026-08-06T01:20:30Z",
                  "status_changed_at": "2026-08-06T01:10:00Z",
                  "manual_override_until": null,
                  "memo": "오전 외근 가능성 있음",
                  "latest_detection": {
                    "id": "det-001",
                    "camera_id": "cam-001",
                    "detected_at": "2026-08-06T01:20:30Z",
                    "person_detected": true,
                    "phone_detected": false,
                    "snapshot_object_key": "snapshots/cam-001/det-001.jpg"
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/EmployeeNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/employees/{employee_id}/memo": {
      "patch": {
        "tags": ["employees"],
        "summary": "직원 메모 수정",
        "description": "직원별 메모를 저장한다. MVP 우선순위 4번.",
        "operationId": "updateEmployeeMemo",
        "parameters": [{ "$ref": "#/components/parameters/EmployeeId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MemoUpdateRequest" },
              "example": { "memo": "오후 2시 회의실 이동 예정" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "메모 저장 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MemoUpdateResponse" },
                "example": {
                  "employee_id": "emp-001",
                  "memo": "오후 2시 회의실 이동 예정",
                  "updated_at": "2026-08-06T01:25:00Z"
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/EmployeeNotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/employee-statuses/{employee_id}/manual-override": {
      "patch": {
        "tags": ["employee-statuses"],
        "summary": "직원 상태 수동 변경",
        "description": "사용자가 직원 상태를 직접 변경한다. 수동 상태가 적용된 동안에는 AI 자동 판정을 적용하지 않는다. MVP 우선순위 5번.",
        "operationId": "setEmployeeStatusManualOverride",
        "parameters": [{ "$ref": "#/components/parameters/EmployeeId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ManualOverrideRequest" },
              "example": {
                "status": "away",
                "reason": "외근",
                "override_until": "2026-08-06T09:00:00Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수동 변경 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ManualOverrideResponse" },
                "example": {
                  "employee_id": "emp-001",
                  "status": "away",
                  "source": "manual",
                  "reason": "외근",
                  "manual_override_until": "2026-08-06T09:00:00Z",
                  "status_changed_at": "2026-08-06T01:25:00Z"
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/EmployeeNotFound" },
          "422": {
            "description": "허용되지 않은 상태값 (`VALIDATION_ERROR`)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "요청 값이 올바르지 않습니다.",
                    "details": {}
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "delete": {
        "tags": ["employee-statuses"],
        "summary": "직원 상태 수동 변경 해제",
        "description": "수동 상태 고정을 해제하고 AI 자동 판정을 다시 적용할 수 있게 한다. MVP 우선순위 6번.",
        "operationId": "clearEmployeeStatusManualOverride",
        "parameters": [{ "$ref": "#/components/parameters/EmployeeId" }],
        "responses": {
          "200": {
            "description": "해제 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ManualOverrideClearResponse" },
                "example": {
                  "employee_id": "emp-001",
                  "manual_override_cleared": true,
                  "updated_at": "2026-08-06T01:30:00Z"
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/EmployeeNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/seats": {
      "get": {
        "tags": ["seats"],
        "summary": "좌석 목록 조회",
        "description": "직원과 카메라 영역을 연결하기 위한 좌석 목록을 조회한다. MVP 우선순위 7번.",
        "operationId": "listSeats",
        "parameters": [
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "좌석 구역으로 거른다.",
            "schema": { "type": "string" },
            "example": "개발팀 구역"
          },
          {
            "name": "camera_id",
            "in": "query",
            "required": false,
            "description": "카메라로 거른다.",
            "schema": { "type": "string" },
            "example": "cam-001"
          },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" }
        ],
        "responses": {
          "200": {
            "description": "목록 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SeatList" },
                "example": {
                  "items": [
                    {
                      "id": "seat-001",
                      "name": "A-01",
                      "area": "개발팀 구역",
                      "camera_id": "cam-001",
                      "employee_id": "emp-001",
                      "employee_name": "홍길동"
                    }
                  ],
                  "total": 1,
                  "limit": 50,
                  "offset": 0
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/cameras": {
      "get": {
        "tags": ["cameras"],
        "summary": "카메라 목록 조회",
        "description": "카메라 연결 상태를 조회한다. MVP 우선순위 8번.",
        "operationId": "listCameras",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "카메라 운영 상태로 거른다.",
            "schema": { "type": "string" },
            "example": "active"
          },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" }
        ],
        "responses": {
          "200": {
            "description": "목록 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CameraList" },
                "example": {
                  "items": [
                    {
                      "id": "cam-001",
                      "name": "사무실 전면 카메라",
                      "location": "개발팀 구역",
                      "status": "active",
                      "stream_status": "connected",
                      "last_seen_at": "2026-08-06T01:20:30Z"
                    }
                  ],
                  "total": 1,
                  "limit": 50,
                  "offset": 0
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/detections": {
      "get": {
        "tags": ["detections"],
        "summary": "탐지 기록 목록 조회",
        "description": "AI 탐지 원본에 가까운 기록을 조회한다. 운영 대시보드보다는 디버깅, 감사, 상태 판정 근거 확인에 사용한다.",
        "operationId": "listDetections",
        "parameters": [
          {
            "name": "employee_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "example": "emp-001"
          },
          {
            "name": "camera_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "example": "cam-001"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "조회 시작 시각 (ISO 8601 UTC, 포함).",
            "schema": { "type": "string", "format": "date-time" },
            "example": "2026-08-06T00:00:00Z"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "조회 종료 시각 (ISO 8601 UTC).",
            "schema": { "type": "string", "format": "date-time" },
            "example": "2026-08-06T23:59:59Z"
          },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Offset" }
        ],
        "responses": {
          "200": {
            "description": "목록 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DetectionList" },
                "example": {
                  "items": [
                    {
                      "id": "det-001",
                      "camera_id": "cam-001",
                      "seat_id": "seat-001",
                      "employee_id": "emp-001",
                      "detected_at": "2026-08-06T01:20:30Z",
                      "person_detected": true,
                      "phone_detected": false,
                      "inferred_status": "working",
                      "snapshot_object_key": "snapshots/cam-001/det-001.jpg"
                    }
                  ],
                  "total": 1,
                  "limit": 50,
                  "offset": 0
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/detections/{detection_id}": {
      "get": {
        "tags": ["detections"],
        "summary": "탐지 기록 상세 조회",
        "description": "탐지된 객체 목록과 사용된 모델 정보를 포함한 상세 기록을 조회한다.",
        "operationId": "getDetection",
        "parameters": [{ "$ref": "#/components/parameters/DetectionId" }],
        "responses": {
          "200": {
            "description": "상세 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DetectionDetail" },
                "example": {
                  "id": "det-001",
                  "camera_id": "cam-001",
                  "seat_id": "seat-001",
                  "employee_id": "emp-001",
                  "detected_at": "2026-08-06T01:20:30Z",
                  "person_detected": true,
                  "phone_detected": false,
                  "inferred_status": "working",
                  "model_name": "yolo",
                  "model_version": "v1",
                  "objects": [
                    {
                      "label": "person",
                      "confidence": 0.94,
                      "bbox": { "x": 120, "y": 80, "width": 220, "height": 360 }
                    }
                  ],
                  "snapshot_object_key": "snapshots/cam-001/det-001.jpg"
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/DetectionNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/detections/{detection_id}/snapshot-url": {
      "post": {
        "tags": ["detections"],
        "summary": "스냅샷 접근 URL 발급",
        "description": "MinIO 객체를 직접 노출하지 않고, 권한 확인 후 제한 시간 있는 URL을 발급한다.\n\n조회지만 URL 발급이라는 부수 효과가 있어 `POST`를 쓴다.",
        "operationId": "issueDetectionSnapshotUrl",
        "parameters": [{ "$ref": "#/components/parameters/DetectionId" }],
        "responses": {
          "200": {
            "description": "URL 발급 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SnapshotUrlResponse" },
                "example": {
                  "url": "https://minio.example.com/presigned-url",
                  "expires_at": "2026-08-06T01:30:00Z"
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/DetectionNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/status-rules": {
      "get": {
        "tags": ["status-rules"],
        "summary": "상태 판정 규칙 조회",
        "description": "프론트엔드가 현재 상태 판정 기준을 표시하거나 운영자가 기준을 확인할 때 사용한다.",
        "operationId": "getStatusRules",
        "responses": {
          "200": {
            "description": "규칙 조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusRules" },
                "example": {
                  "away_after_seconds": 180,
                  "off_work_after_seconds": 3600,
                  "rules": [
                    {
                      "condition": "person_detected=true, phone_detected=false",
                      "status": "working"
                    },
                    {
                      "condition": "person_detected=true, phone_detected=true",
                      "status": "on_call"
                    },
                    {
                      "condition": "person_not_detected_for_seconds>=180",
                      "status": "away"
                    },
                    {
                      "condition": "person_not_detected_for_seconds>=3600",
                      "status": "off_work"
                    }
                  ]
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/internal/v1/inferences": {
      "post": {
        "tags": ["internal"],
        "summary": "내부 추론 요청",
        "description": "`stream-server`가 프레임 또는 이미지 객체를 `inference` 서비스에 전달해 객체 탐지를 요청한다. MVP 우선순위 9번.\n\n`deeplearning`의 출력은 라벨과 신뢰도까지다. 비즈니스 해석(상태 판정)은 `fastapi`가 한다.",
        "operationId": "requestInference",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InferenceRequest" },
              "example": {
                "camera_id": "cam-001",
                "frame_id": "frame-20260806-012030-001",
                "captured_at": "2026-08-06T01:20:30Z",
                "image_object_key": "frames/cam-001/frame-001.jpg"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "추론 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InferenceResponse" },
                "example": {
                  "frame_id": "frame-20260806-012030-001",
                  "model_name": "yolo",
                  "model_version": "v1",
                  "processed_at": "2026-08-06T01:20:31Z",
                  "objects": [
                    {
                      "label": "person",
                      "confidence": 0.94,
                      "bbox": { "x": 120, "y": 80, "width": 220, "height": 360 }
                    },
                    {
                      "label": "phone",
                      "confidence": 0.86,
                      "bbox": { "x": 260, "y": 180, "width": 80, "height": 70 }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/internal/v1/detections": {
      "post": {
        "tags": ["internal"],
        "summary": "내부 탐지 결과 등록",
        "description": "`stream-server` 또는 `inference`가 backend에 탐지 결과를 등록한다. backend는 이 결과를 기반으로 직원 상태를 판정하고 저장한다. MVP 우선순위 10번.",
        "operationId": "ingestDetection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DetectionIngestRequest" },
              "example": {
                "camera_id": "cam-001",
                "frame_id": "frame-20260806-012030-001",
                "captured_at": "2026-08-06T01:20:30Z",
                "snapshot_object_key": "snapshots/cam-001/det-001.jpg",
                "model_name": "yolo",
                "model_version": "v1",
                "objects": [
                  {
                    "label": "person",
                    "confidence": 0.94,
                    "bbox": { "x": 120, "y": 80, "width": 220, "height": 360 }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DetectionIngestResponse" },
                "example": {
                  "id": "det-001",
                  "affected_employee_ids": ["emp-001"],
                  "created_at": "2026-08-06T01:20:32Z"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/internal/v1/cameras/{camera_id}/stream-status": {
      "put": {
        "tags": ["internal"],
        "summary": "내부 카메라 스트림 상태 갱신",
        "description": "`stream-server`가 카메라 연결 상태를 backend에 보고한다. MVP 우선순위 11번.",
        "operationId": "updateCameraStreamStatus",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "cam-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StreamStatusUpdateRequest" },
              "example": {
                "stream_status": "connected",
                "last_seen_at": "2026-08-06T01:20:30Z",
                "message": null
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "갱신 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StreamStatusUpdateResponse" },
                "example": {
                  "camera_id": "cam-001",
                  "stream_status": "connected",
                  "updated_at": "2026-08-06T01:20:30Z"
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/CameraNotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "한 번에 가져올 개수. 기본 50, 최대 200.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "description": "건너뛸 개수. 기본 0.",
        "schema": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "EmployeeId": {
        "name": "employee_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "example": "emp-001"
      },
      "DetectionId": {
        "name": "detection_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "example": "det-001"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "잘못된 요청 값",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "인증되지 않음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "권한 없음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "현재 상태와 충돌",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ValidationError": {
        "description": "요청 스키마 검증 실패",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalError": {
        "description": "서버 내부 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "내부 서비스 사용 불가",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "EmployeeNotFound": {
        "description": "직원이 없음 (`EMPLOYEE_NOT_FOUND`)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": {
                "code": "EMPLOYEE_NOT_FOUND",
                "message": "요청한 직원을 찾을 수 없습니다.",
                "details": {}
              }
            }
          }
        }
      },
      "DetectionNotFound": {
        "description": "탐지 기록이 없음 (`DETECTION_NOT_FOUND`)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": {
                "code": "DETECTION_NOT_FOUND",
                "message": "요청한 탐지 기록을 찾을 수 없습니다.",
                "details": {}
              }
            }
          }
        }
      },
      "CameraNotFound": {
        "description": "카메라가 없음 (`CAMERA_NOT_FOUND`)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": {
                "code": "CAMERA_NOT_FOUND",
                "message": "요청한 카메라를 찾을 수 없습니다.",
                "details": {}
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message", "details"],
        "properties": {
          "code": {
            "type": "string",
            "description": "대문자 스네이크 표기 오류 코드.",
            "example": "EMPLOYEE_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "사용자에게 보여줄 수 있는 한국어 설명. 스택 트레이스·쿼리·내부 주소를 넣지 않는다."
          },
          "details": {
            "type": "object",
            "description": "추가 정보. 없으면 빈 객체.",
            "additionalProperties": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetail" }
        },
        "example": {
          "error": {
            "code": "EMPLOYEE_NOT_FOUND",
            "message": "요청한 직원을 찾을 수 없습니다.",
            "details": {}
          }
        }
      },
      "EmployeeStatusValue": {
        "type": "string",
        "description": "직원 상태. `working` 근무중 / `on_call` 통화중 / `away` 부재중 / `off_work` 퇴근.",
        "enum": ["working", "on_call", "away", "off_work"]
      },
      "StatusSource": {
        "type": "string",
        "description": "상태가 정해진 근거. `ai` AI 탐지 자동 판정 / `manual` 사용자가 직접 설정 / `system` 시간 조건 등 시스템 규칙.",
        "enum": ["ai", "manual", "system"]
      },
      "StreamStatus": {
        "type": "string",
        "description": "`connected` 정상 연결 / `disconnected` 연결 끊김 / `reconnecting` 재연결 중 / `unknown` 상태 불명.",
        "enum": ["connected", "disconnected", "reconnecting", "unknown"]
      },
      "DetectionLabel": {
        "type": "string",
        "description": "탐지 대상. `person` 사람 / `phone` 통화기 또는 전화기 사용 상태. 전화기 탐지 기준(휴대폰·유선전화·손에 든 전화기)은 **결정 필요**.",
        "enum": ["person", "phone"]
      },
      "BoundingBox": {
        "type": "object",
        "description": "이미지 좌표계 기준 픽셀 값.",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 0 },
          "height": { "type": "integer", "minimum": 0 }
        }
      },
      "DetectedObject": {
        "type": "object",
        "required": ["label", "confidence", "bbox"],
        "properties": {
          "label": { "$ref": "#/components/schemas/DetectionLabel" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "example": 0.94 },
          "bbox": { "$ref": "#/components/schemas/BoundingBox" }
        }
      },
      "Employee": {
        "type": "object",
        "required": ["id", "name", "seat_id", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "example": "emp-001" },
          "name": { "type": "string", "example": "홍길동" },
          "seat_id": { "type": "string", "example": "seat-001" },
          "memo": { "type": ["string", "null"], "example": "오전 외근 가능성 있음" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "SeatRoi": {
        "allOf": [{ "$ref": "#/components/schemas/BoundingBox" }],
        "description": "좌석 판정에 사용할 관심 영역. 초기에는 수동 좌표 등록을 가정한다. UI 편집 기능은 **결정 필요**."
      },
      "Seat": {
        "type": "object",
        "required": ["id", "name", "area", "camera_id"],
        "properties": {
          "id": { "type": "string", "example": "seat-001" },
          "name": { "type": "string", "example": "A-01" },
          "area": { "type": "string", "example": "개발팀 구역" },
          "camera_id": { "type": "string", "example": "cam-001" },
          "roi": { "$ref": "#/components/schemas/SeatRoi" }
        }
      },
      "EmployeeStatus": {
        "type": "object",
        "required": [
          "employee_id",
          "seat_id",
          "status",
          "source",
          "last_detected_at",
          "status_changed_at"
        ],
        "properties": {
          "employee_id": { "type": "string", "example": "emp-001" },
          "seat_id": { "type": "string", "example": "seat-001" },
          "status": { "$ref": "#/components/schemas/EmployeeStatusValue" },
          "source": { "$ref": "#/components/schemas/StatusSource" },
          "last_detected_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "마지막으로 사람이 탐지된 시각."
          },
          "status_changed_at": { "type": "string", "format": "date-time" },
          "manual_override_until": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "수동 상태 유지 종료 시각. `null`이면 수동 고정이 없다."
          }
        }
      },
      "DashboardSummary": {
        "type": "object",
        "required": [
          "total_employee_count",
          "working_count",
          "on_call_count",
          "away_count",
          "off_work_count",
          "last_updated_at"
        ],
        "properties": {
          "total_employee_count": { "type": "integer", "minimum": 0, "example": 24 },
          "working_count": { "type": "integer", "minimum": 0, "example": 15 },
          "on_call_count": { "type": "integer", "minimum": 0, "example": 3 },
          "away_count": { "type": "integer", "minimum": 0, "example": 4 },
          "off_work_count": { "type": "integer", "minimum": 0, "example": 2 },
          "last_updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "EmployeeStatusListItem": {
        "type": "object",
        "required": [
          "employee_id",
          "employee_name",
          "seat_id",
          "seat_name",
          "area",
          "status",
          "source",
          "status_changed_at"
        ],
        "properties": {
          "employee_id": { "type": "string" },
          "employee_name": { "type": "string" },
          "seat_id": { "type": "string" },
          "seat_name": { "type": "string" },
          "area": { "type": "string" },
          "status": { "$ref": "#/components/schemas/EmployeeStatusValue" },
          "source": { "$ref": "#/components/schemas/StatusSource" },
          "last_detected_at": { "type": ["string", "null"], "format": "date-time" },
          "status_changed_at": { "type": "string", "format": "date-time" },
          "memo": { "type": ["string", "null"] }
        }
      },
      "EmployeeStatusList": {
        "type": "object",
        "description": "목록 응답. 응답 래퍼를 쓰지 않고 `items/total/limit/offset`을 그대로 둔다.",
        "required": ["items", "total", "limit", "offset"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmployeeStatusListItem" }
          },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      },
      "LatestDetection": {
        "type": "object",
        "description": "상태 판정 근거가 된 가장 최근 탐지.",
        "required": ["id", "camera_id", "detected_at", "person_detected", "phone_detected"],
        "properties": {
          "id": { "type": "string" },
          "camera_id": { "type": "string" },
          "detected_at": { "type": "string", "format": "date-time" },
          "person_detected": { "type": "boolean" },
          "phone_detected": { "type": "boolean" },
          "snapshot_object_key": {
            "type": ["string", "null"],
            "description": "MinIO 객체 키. 직접 접근하지 않고 스냅샷 URL 발급 API를 거친다."
          }
        }
      },
      "EmployeeStatusDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/EmployeeStatusListItem" },
          {
            "type": "object",
            "properties": {
              "manual_override_until": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "latest_detection": {
                "oneOf": [
                  { "$ref": "#/components/schemas/LatestDetection" },
                  { "type": "null" }
                ],
                "description": "탐지 기록이 없으면 `null`. '데이터 없음'과 '조회 실패'를 구분한다."
              }
            }
          }
        ]
      },
      "MemoUpdateRequest": {
        "type": "object",
        "required": ["memo"],
        "properties": {
          "memo": {
            "type": "string",
            "maxLength": 500,
            "description": "빈 문자열이면 메모를 지운다. 최대 길이는 **결정 필요** — 500은 초안 값이다."
          }
        }
      },
      "MemoUpdateResponse": {
        "type": "object",
        "required": ["employee_id", "memo", "updated_at"],
        "properties": {
          "employee_id": { "type": "string" },
          "memo": { "type": ["string", "null"] },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ManualOverrideRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "description": "수동으로 지정할 상태. 명세서 기준으로 `away`와 `off_work`만 수동 설정 대상이다.",
            "allOf": [{ "$ref": "#/components/schemas/EmployeeStatusValue" }]
          },
          "reason": { "type": ["string", "null"], "example": "외근" },
          "override_until": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "이 시각까지 AI 자동 판정을 적용하지 않는다. `null`이면 해제 API를 호출할 때까지 유지한다."
          }
        }
      },
      "ManualOverrideResponse": {
        "type": "object",
        "required": ["employee_id", "status", "source", "status_changed_at"],
        "properties": {
          "employee_id": { "type": "string" },
          "status": { "$ref": "#/components/schemas/EmployeeStatusValue" },
          "source": { "$ref": "#/components/schemas/StatusSource" },
          "reason": { "type": ["string", "null"] },
          "manual_override_until": { "type": ["string", "null"], "format": "date-time" },
          "status_changed_at": { "type": "string", "format": "date-time" }
        }
      },
      "ManualOverrideClearResponse": {
        "type": "object",
        "required": ["employee_id", "manual_override_cleared", "updated_at"],
        "properties": {
          "employee_id": { "type": "string" },
          "manual_override_cleared": { "type": "boolean" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "SeatListItem": {
        "type": "object",
        "required": ["id", "name", "area", "camera_id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "area": { "type": "string" },
          "camera_id": { "type": "string" },
          "employee_id": {
            "type": ["string", "null"],
            "description": "배정된 직원이 없으면 `null`."
          },
          "employee_name": { "type": ["string", "null"] }
        }
      },
      "SeatList": {
        "type": "object",
        "required": ["items", "total", "limit", "offset"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SeatListItem" }
          },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      },
      "Camera": {
        "type": "object",
        "required": ["id", "name", "location", "status", "stream_status"],
        "properties": {
          "id": { "type": "string", "example": "cam-001" },
          "name": { "type": "string", "example": "사무실 전면 카메라" },
          "location": { "type": "string", "example": "개발팀 구역" },
          "status": {
            "type": "string",
            "description": "카메라 운영 상태. 허용값 목록은 **결정 필요**.",
            "example": "active"
          },
          "stream_status": { "$ref": "#/components/schemas/StreamStatus" },
          "last_seen_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "CameraList": {
        "type": "object",
        "required": ["items", "total", "limit", "offset"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Camera" }
          },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      },
      "DetectionListItem": {
        "type": "object",
        "required": [
          "id",
          "camera_id",
          "detected_at",
          "person_detected",
          "phone_detected",
          "inferred_status"
        ],
        "properties": {
          "id": { "type": "string" },
          "camera_id": { "type": "string" },
          "seat_id": { "type": ["string", "null"] },
          "employee_id": { "type": ["string", "null"] },
          "detected_at": { "type": "string", "format": "date-time" },
          "person_detected": { "type": "boolean" },
          "phone_detected": { "type": "boolean" },
          "inferred_status": { "$ref": "#/components/schemas/EmployeeStatusValue" },
          "snapshot_object_key": { "type": ["string", "null"] }
        }
      },
      "DetectionList": {
        "type": "object",
        "required": ["items", "total", "limit", "offset"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DetectionListItem" }
          },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      },
      "DetectionDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/DetectionListItem" },
          {
            "type": "object",
            "required": ["model_name", "model_version", "objects"],
            "properties": {
              "model_name": { "type": "string", "example": "yolo" },
              "model_version": { "type": "string", "example": "v1" },
              "objects": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/DetectedObject" }
              }
            }
          }
        ]
      },
      "SnapshotUrlResponse": {
        "type": "object",
        "required": ["url", "expires_at"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "제한 시간이 있는 접근 URL."
          },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "InferenceRequest": {
        "type": "object",
        "required": ["camera_id", "frame_id", "captured_at", "image_object_key"],
        "properties": {
          "camera_id": { "type": "string" },
          "frame_id": { "type": "string", "example": "frame-20260806-012030-001" },
          "captured_at": { "type": "string", "format": "date-time" },
          "image_object_key": {
            "type": "string",
            "description": "추론할 이미지의 객체 키. 프레임 바이트를 본문에 싣지 않는다."
          }
        }
      },
      "InferenceResponse": {
        "type": "object",
        "description": "출력은 라벨과 신뢰도까지다. 상태 판정은 포함하지 않는다.",
        "required": ["frame_id", "model_name", "model_version", "processed_at", "objects"],
        "properties": {
          "frame_id": { "type": "string" },
          "model_name": { "type": "string" },
          "model_version": { "type": "string" },
          "processed_at": { "type": "string", "format": "date-time" },
          "objects": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DetectedObject" }
          }
        }
      },
      "DetectionIngestRequest": {
        "type": "object",
        "required": ["camera_id", "frame_id", "captured_at", "model_name", "model_version", "objects"],
        "properties": {
          "camera_id": { "type": "string" },
          "frame_id": { "type": "string" },
          "captured_at": { "type": "string", "format": "date-time" },
          "snapshot_object_key": { "type": ["string", "null"] },
          "model_name": { "type": "string" },
          "model_version": { "type": "string" },
          "objects": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DetectedObject" }
          }
        }
      },
      "DetectionIngestResponse": {
        "type": "object",
        "required": ["id", "affected_employee_ids", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "affected_employee_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "이 탐지 결과로 상태가 재판정된 직원 목록."
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "StreamStatusUpdateRequest": {
        "type": "object",
        "required": ["stream_status", "last_seen_at"],
        "properties": {
          "stream_status": { "$ref": "#/components/schemas/StreamStatus" },
          "last_seen_at": { "type": "string", "format": "date-time" },
          "message": {
            "type": ["string", "null"],
            "description": "연결 끊김 사유 등 부가 설명."
          }
        }
      },
      "StreamStatusUpdateResponse": {
        "type": "object",
        "required": ["camera_id", "stream_status", "updated_at"],
        "properties": {
          "camera_id": { "type": "string" },
          "stream_status": { "$ref": "#/components/schemas/StreamStatus" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "StatusRule": {
        "type": "object",
        "required": ["condition", "status"],
        "properties": {
          "condition": {
            "type": "string",
            "example": "person_detected=true, phone_detected=false"
          },
          "status": { "$ref": "#/components/schemas/EmployeeStatusValue" }
        }
      },
      "StatusRules": {
        "type": "object",
        "required": ["away_after_seconds", "off_work_after_seconds", "rules"],
        "properties": {
          "away_after_seconds": {
            "type": "integer",
            "minimum": 0,
            "example": 180,
            "description": "사람이 탐지되지 않은 시간이 이 값을 넘으면 `away`."
          },
          "off_work_after_seconds": {
            "type": "integer",
            "minimum": 0,
            "example": 3600,
            "description": "사람이 탐지되지 않은 시간이 이 값을 넘으면 `off_work`."
          },
          "rules": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StatusRule" }
          }
        }
      }
    }
  }
}
