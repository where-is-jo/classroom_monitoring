# deeplearning(얼굴 분석 내부 서비스)의 환경변수 목록 기준 문서다.
# 로컬 직접 실행은 이 파일을 deeplearning/.env로 복사해 실제 값을 채운다. Docker는
# 별도의 .docker/env/deeplearning.<환경>.env를 Compose가 주입한다. 두 실제 파일은
# 커밋하거나 Docker 이미지에 복사하지 않는다.
#
# 규칙: docs/conventions/environment-convention.md

# --- 모델 가중치 경로 ---
# 셋 다 파일이 실제로 있어야 한다. app.py가 기동(lifespan) 시점에 확인하고
# 없으면 RuntimeError로 죽는다. 요청을 받다가 실패하지 않게 하려는 것이다.
#
# 가중치는 저장소에 없다(.models/는 .gitignore 대상, 합쳐서 448MB).
# 로컬 직접 실행에서는 현재 호스트의 절대경로를 적는다. 컨테이너에서는 Compose가
# /models/face 아래 경로로 덮어쓰고 .docker/models/face를 읽기 전용 마운트한다.

# SCRFD 얼굴 검출 모델.
FACE_DETECTION_MODEL_PATH=

# MediaPipe Face Landmarker. 자세(yaw·pitch·roll) 추정에 쓴다.
FACE_LANDMARKER_MODEL_PATH=

# arcface가 기본값이다. AdaFace 전환은 모델·버전·컬렉션·임계값 파일을 한 번에 바꾼다.
FACE_RECOGNIZER=arcface
# ArcFace: insightface-buffalo_l-w600k_r50-v0.7
# AdaFace: cvlface-adaface-ir50-webface4m-fe7718c6
FACE_RECOGNITION_MODEL_VERSION=insightface-buffalo_l-w600k_r50-v0.7
FACE_RECOGNITION_MODEL_PATH=

# --- 실시간 학생 식별 ---
# false면 기존 얼굴 등록 분석·embedding API만 제공한다.
FACE_IDENTIFICATION_ENABLED=false

# FastAPI가 학생 대표 embedding을 저장한 MongoDB를 읽기 전용으로 조회한다.
# URL에는 자격 증명이 포함될 수 있으므로 실제 값을 커밋하지 않는다.
FACE_GALLERY_DATABASE_URL=
FACE_GALLERY_DATABASE_NAME=
# ArcFace: face_embeddings_arcface / AdaFace: face_embeddings_adaface
FACE_EMBEDDING_COLLECTION=face_embeddings_arcface
FACE_GALLERY_TIMEOUT_SECONDS=5
FACE_GALLERY_REFRESH_SECONDS=30

# face-eval-harness의 validation 평가로 고른 값을 넣는다. 숫자 세 개 직접 주입은 로컬
# 호환용으로만 남기며, dev/prod 배포 검증기는 metadata가 포함된 파일을 반드시 요구한다.
FACE_IDENTITY_THRESHOLD_FILE=
FACE_IDENTITY_SIMILARITY_THRESHOLD=
FACE_IDENTITY_MARGIN_THRESHOLD=
FACE_IDENTITY_TRACK_SIMILARITY_THRESHOLD=

# 얼굴 검출·품질·시간 합의. 환경마다 바꾸는 비밀값은 아니지만 현재 모델 검증값이
# 확정되지 않아 식별 서비스 설정으로 주입한다.
FACE_DETECTION_THRESHOLD=0.6
FACE_IDENTITY_MIN_DETECTION_CONFIDENCE=0.6
FACE_MINIMUM_SIZE=40
FACE_PREFERRED_SIZE=112
FACE_MINIMUM_BLUR_SCORE=20
FACE_PREFERRED_BLUR_SCORE=100
FACE_UNCERTAIN_QUALITY_THRESHOLD=0.45
FACE_USE_FLIP_TTA=true
FACE_TTA_SIMILARITY_BAND=0.08
FACE_TTA_MARGIN_BAND=0.06
FACE_IDENTITY_HISTORY_SIZE=12
FACE_IDENTITY_MINIMUM_OBSERVATIONS=4
FACE_IDENTITY_TRACK_STALE_FRAMES=30
