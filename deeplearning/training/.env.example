# 사람 탐지 모델 학습 노트북 설정.
# 값은 여기 아닌 .env에 채운다. .env는 커밋하지 않는다.

# 학습 실행 장치: cpu | cuda
DEVICE=cuda

# YOLO 포맷 데이터셋 루트 절대경로. images/, labels/, data.yaml을 포함해야 한다.
# 공용 서버에 SSH·rsync로 미리 올려 둔 경로를 가리킨다. 저장소 안 경로를 쓰지 않는다 —
# 데이터셋은 .gitignore 대상이다.
DATASET_DIR=

# 기준(사전학습) 가중치. 후보: yolo11m.pt(현재 worker/inference 기본값), yolo11n.pt, yolo11s.pt
# 모델 버전이 아직 결정되지 않았으므로(deeplearning/README.md #모델-선정) 고정하지 않는다.
BASE_WEIGHTS_PATH=yolov8n.pt

# 학습 에폭 수
EPOCHS=100

# 입력 이미지 크기(정사각형 한 변 픽셀)
IMAGE_SIZE=640

# 배치 크기. 공용 GPU를 여러 명이 나눠 쓰므로 VRAM 여유를 보고 낮춘다.
BATCH_SIZE=16

# 학습 산출물(runs/) 저장 경로. 비워두면 notebooks/../runs를 쓴다.
# 이 경로도 커밋하지 않는다.
OUTPUT_DIR=

# 등록 학생 독립 평가(v2). 비우면 gallery의 모든 학생을 평가한다.
EVALUATION_STUDENT_IDS=
EVALUATION_SAMPLES_PER_STUDENT=30
EVALUATION_SAMPLE_INTERVAL_SECONDS=0.25
# 비우면 deeplearning/training/runs/face_identification에 집계 JSON을 저장한다.
EVALUATION_OUTPUT_DIR=

# 얼굴 식별 모델 비교 하네스 출력. 비우면 eval.csv 옆 thresholds.json을 만든다.
# 이 산출물은 실시간 deeplearning의 FACE_IDENTITY_THRESHOLD_FILE로 연결한다.
FACE_RECOGNIZER=arcface
FACE_DETECTION_MODEL_PATH=
FACE_RECOGNITION_MODEL_PATH=
FACE_RECOGNITION_MODEL_VERSION=insightface-buffalo_l-w600k_r50-v0.7
# 전처리 버전은 FACE_RECOGNIZER에 따라 런타임 선택 객체가 고정한다. AdaFace 평가 시
# recognizer·모델 경로·모델 버전·아래 collection을 한 묶음으로 바꾼다.
FACE_EVAL_KNOWN_VALIDATION_DIR=
FACE_EVAL_UNKNOWN_VALIDATION_DIR=
FACE_EVAL_KNOWN_TEST_DIR=
FACE_EVAL_UNKNOWN_TEST_DIR=
FACE_EVAL_GALLERY_SOURCE=directory
FACE_EVAL_GALLERY_DIR=
# FACE_EVAL_GALLERY_SOURCE=mongodb일 때 등록 embedding을 읽을 접속 정보.
# URI에는 자격 증명이 들어갈 수 있으므로 .env.example에는 실제 값을 넣지 않는다.
MONGODB_URI=
MONGODB_DATABASE=
FACE_EMBEDDING_COLLECTION=face_embeddings_arcface
FACE_EVAL_TARGET_FAR=0.001
# 다른 학생 얼굴 쌍을 같은 얼굴 track으로 연결해도 되는 최대 비율
FACE_EVAL_TRACK_TARGET_FALSE_ASSOCIATION=0.001
FACE_EVAL_OUTPUT_CSV=
FACE_EVAL_THRESHOLD_OUTPUT=
FACE_EVAL_SUMMARY_OUTPUT=

# 얼굴 식별 v9 실시간 교실용 하이브리드 실행 설정
# 실제 CCTV 검증 시 RTSP URL. 비밀번호가 포함될 수 있으므로 실제 값은 .env.face에만 둔다.
# 비우면 CAMERA_INDEX의 로컬 웹캠을 사용한다.
FACE_RTSP_URL=
# 정면 얼굴 인식용 홈캠. 02_person_detection_tracking_v1.ipynb에서만 사용한다.
# rtsp: HOME_CAM_RTSP_URL, webcam: HOME_CAM_CAMERA_INDEX를 사용한다.
HOME_CAM_SOURCE=rtsp
HOME_CAM_RTSP_URL=
HOME_CAM_CAMERA_INDEX=0
# 홈캠 사람 검출·ByteTrack 설정
HOME_CAM_PERSON_MODEL_PATH=yolo11m.pt
HOME_CAM_PERSON_CONFIDENCE=0.25
HOME_CAM_TRACKER_CONFIG=bytetrack.yaml
HOME_CAM_FACE_COVERAGE_THRESHOLD=0.80
HOME_CAM_IDENTITY_HISTORY_SIZE=12
HOME_CAM_IDENTITY_MINIMUM_OBSERVATIONS=4
HOME_CAM_TRACK_STALE_FRAMES=30
HOME_CAM_DIAGNOSTIC_OUTPUT_DIR=
# 두 카메라 교차 추적 v2. 비우면 ENTRY는 HOME_CAM_*, CLASSROOM RTSP는 FACE_RTSP_URL을 재사용한다.
ENTRY_CAMERA_SOURCE=rtsp
ENTRY_CAMERA_RTSP_URL=
ENTRY_CAMERA_INDEX=0
CLASSROOM_CAMERA_SOURCE=webcam
CLASSROOM_CAMERA_RTSP_URL=
CLASSROOM_CAMERA_INDEX=0
PERSON_REID_MODEL_PATH=
PERSON_REID_HISTORY_SIZE=8
PERSON_REID_INTERVAL=3
CROSS_CAMERA_CALIBRATION_FILE=
CROSS_CAMERA_RECALIBRATE=false
CROSS_CAMERA_APPEARANCE_WEIGHT=0.60
CROSS_CAMERA_GEOMETRY_WEIGHT=0.25
CROSS_CAMERA_TIME_WEIGHT=0.15
CROSS_CAMERA_MINIMUM_SCORE=0.70
CROSS_CAMERA_MINIMUM_MARGIN=0.08
CROSS_CAMERA_MAXIMUM_TIME_DIFFERENCE=0.50
CROSS_CAMERA_MAXIMUM_GEOMETRY_DISTANCE=0.20
CROSS_CAMERA_STALE_SECONDS=2.0
CROSS_CAMERA_DIAGNOSTIC_OUTPUT_DIR=
FACE_DETECTION_THRESHOLD=0.4
FACE_IDENTITY_MIN_DETECTION_CONFIDENCE=0.6
# v10 SCRFD 검출 전용 후보·확정 기준
FACE_CANDIDATE_THRESHOLD=0.30
FACE_CONFIRMED_THRESHOLD=0.60
FACE_BOX_STALE_CYCLES=3
FACE_DETECTION_INPUT_SIZE=1280
FACE_FULL_DETECTION_INTERVAL=2
FACE_TILE_DETECTION_INTERVAL=10
FACE_RECOGNITION_INTERVAL=6
FACE_FPS_AVERAGE_WINDOW=30
FACE_DISPLAY_MAX_WIDTH=1280
FACE_DISPLAY_MAX_HEIGHT=720
FACE_DISPLAY_ALLOW_UPSCALE=true
FACE_DISPLAY_FULLSCREEN=true
FACE_DIAGNOSTIC_OUTPUT_DIR=
FACE_TILE_ROWS=2
FACE_TILE_COLUMNS=2
FACE_TILE_OVERLAP=0.20
FACE_TILE_NMS_IOU_THRESHOLD=0.35
FACE_TILE_CONTAINMENT_THRESHOLD=0.80
